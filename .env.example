# =============================================================================
# ApplyPilot AI - environment configuration
# Copy this file to ".env" and adjust the values you need.
# The .env file is git-ignored, never commit your real API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# AI provider selection
# -----------------------------------------------------------------------------
# "fake"               -> deterministic offline demo provider, no API calls.
#                         This is the DEFAULT and is used when the variable is
#                         missing, empty, or when AI_API_KEY is not set.
# "openai_compatible"  -> any provider that exposes the OpenAI HTTP API
#                         (chat/completions). Works with OpenAI, Groq, Mistral,
#                         OpenRouter, Together, DeepSeek, Ollama, LM Studio,
#                         Anthropic via official OpenAI-compatible endpoint, etc.
#
# IMPORTANT: filling in AI_API_KEY alone is NOT enough - you must also flip
# AI_PROVIDER to "openai_compatible" (here OR via the in-app
# File > AI provider settings dialog) for the app to actually call the API.
AI_PROVIDER=fake

# -----------------------------------------------------------------------------
# OpenAI-compatible provider settings (only used when AI_PROVIDER != "fake")
# -----------------------------------------------------------------------------
# Examples of base URLs and models you can plug in:
#
#   # OpenAI
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#
#   # Groq (free tier, very fast)
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#
#   # Mistral
#   AI_BASE_URL=https://api.mistral.ai/v1
#   AI_MODEL=mistral-small-latest
#
#   # OpenRouter (single key, hundreds of models)
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=anthropic/claude-3.5-sonnet
#
#   # DeepSeek
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
#
#   # Local Ollama (no key needed, leave AI_API_KEY empty or any string)
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.1
#
#   # Local LM Studio
#   AI_BASE_URL=http://localhost:1234/v1
#   AI_MODEL=local-model
#
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Behaviour tweaks (all optional)
# -----------------------------------------------------------------------------
# Request timeout in seconds for AI HTTP calls. Default 180 s (was 60 s) so
# long analyze_candidate calls on big CVs don't get killed mid-stream and
# force a billable retry. Drop it to 60 if you're on a fast model AND a
# stable connection and want faster failures.
AI_TIMEOUT=180

# Default temperature for AI responses (0.0-2.0). Lower = more deterministic.
AI_TEMPERATURE=0.2

# Log every real (non-fake) AI request to logs/ai_requests.log
AI_REQUEST_LOG=true

# Print full prompt and response previews to the logs at DEBUG level. Useful
# while debugging, but VERY noisy - leave it off in normal use. Combine with
# APPLYPILOT_LOG_LEVEL=DEBUG to actually see the previews.
AI_DEBUG_PROMPTS=false

# Show a "Refine with AI costs ~$X - continue?" modal before every refine
# call. Default true so a stray double click never silently doubles spend.
# The modal has a "Don't ask again this session" checkbox.
AI_CONFIRM_REFINE=true

# -----------------------------------------------------------------------------
# Optional GitHub token to raise the public REST API rate limits from
# 60 req/h (anonymous) to 5000 req/h. Paste your GitHub *profile URL* in the
# Setup screen (e.g. https://github.com/your-username) and the app will fetch
# repository metadata automatically. The token is OPTIONAL - leave it empty
# for occasional use.
#
# Create a fine-grained token with read-only "Public repositories" access:
# https://github.com/settings/personal-access-tokens
# -----------------------------------------------------------------------------
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Application behaviour
# -----------------------------------------------------------------------------
# Where the app should store generated outputs (relative or absolute).
APPLYPILOT_OUTPUT_DIR=outputs

# Logging level: DEBUG, INFO, WARNING, ERROR.
APPLYPILOT_LOG_LEVEL=INFO

# UI language is NOT configurable via .env on purpose. Pick it inside the app
# via File > Language; the choice is persisted to ~/.applypilot/state.json
# and survives restarts.
