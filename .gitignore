# Environment & secrets
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
user_data/
~/.applypilot/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
# Disposable venv created by build_exe.bat for the Windows EXE build
.venv-build/

# Testing & type checkers
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Build artifacts (PyInstaller / Nuitka, optional later)
*.spec
build/
dist/
# Resource files we DO want committed even though dist/ is ignored:
# the build_exe.bat icon. Listed explicitly so a future ``dist/*``
# unignore never accidentally drops the icon from history.
!assets/applypilot.ico

# Local app outputs (user-generated, may contain personal data)
outputs/*
!outputs/.gitkeep

# Local user CV / personal docs (never commit)
*.pdf
*.docx
*.doc
!sample_data/*.pdf
!sample_data/*.docx
!docs/**/*.pdf

# HTML CVs / LinkedIn exports / generated styled resumes
# (block private files but allow committed samples and generated outputs)
*.html
*.htm
!sample_data/*.html
!sample_data/*.htm
!docs/**/*.html
!outputs/**/*.html
!outputs/**/*.htm

# Local settings persisted by the app
applypilot_settings.json
.applypilot/

# Python tooling
.python-version
pip-log.txt
pip-delete-this-directory.txt

# Merge / backup leftovers
*.bak
*.orig
*.rej

# Crash dumps (Qt)
*.crash
*.dmp

# Local cache & temp
.cache/
tmp/
temp/
.tmp/

# JetBrains
*.iml
